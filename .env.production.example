# Copier en .env.production puis renseigner. Ce fichier ne doit jamais être commité.

# MongoDB — l'administrateur ne sert qu'à l'initialisation du conteneur
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# Utilisateur applicatif dédié, seul utilisé par l'API
MONGO_APP_DATABASE=paris_janitor
MONGO_APP_USERNAME=paris_janitor_app
MONGO_APP_PASSWORD=

# API
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
MONGODB_URI=mongodb://paris_janitor_app:motdepasse@mongo:27017/paris_janitor?authSource=paris_janitor
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://voyageurs.exemple.fr,https://admin.exemple.fr
APP_TRAVELER_URL=https://voyageurs.exemple.fr

# Stripe — clés live ou test selon l'environnement.
# STRIPE_WEBHOOK_SECRET provient de l'endpoint déclaré dans le Dashboard Stripe,
# il diffère de celui affiché par « stripe listen » en local.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BAGPACKER_MONTHLY=
STRIPE_PRICE_BAGPACKER_YEARLY=
STRIPE_PRICE_EXPLORATOR_MONTHLY=
STRIPE_PRICE_EXPLORATOR_YEARLY=
STRIPE_RENEWAL_COUPON_ID=

# Ports publiés par docker compose
API_PORT=3000
TRAVELER_PORT=8080
ADMIN_PORT=8081
